{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string"
    },
    "hero-image": {
      "type": "string"
    },
    "thumbnail": {
      "type": "string"
    },
    "accreditation-images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "useful-links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "link": {
            "type": "object",
            "properties": {
              "link-text": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "link-text",
              "url"
            ]
          }
        },
        "required": [
          "link"
        ]
      }
    },
    "draft": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "author",
    "hero-image",
    "thumbnail"
  ]
}