---
import Grass from "../../assets/grass.webp";
import hazelLogoPartialOatHusk from "../../assets/LogoPartial/HFL01_Logo_Setup_Wordmark_R0a copy_HFL_Wordmark_Oat.svg";
import Video from "../../assets/videos/Resources_Video.mp4";
---

<section class="hero">
  <div class="vid-wrapper">
    <video id="hero-vid"
      autoplay
      preload="metadata"
      disablepictureinpicture
      muted
      loop
      playsinline
      webkit-playsinline
      disableRemotePlayback
      controlslist="noremoteplayback nodownload"
      poster={Grass.src}
    >
      <source src={Video} type="video/mp4" />
    </video>
  </div>
  <h1>Resources</h1>
</section>

<style lang="scss">
  section.hero {
    margin: 0;
    padding-top: 6.25rem;
    width: 100%;
    height: 80vh;
    color: var(--oat-husk);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    position: relative; 
    div.vid-wrapper {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 1;
      video {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
      }
    }
    h1 {
      z-index: 3;
      padding: 0 0 2rem 2rem;
      font-size: 3rem;
      font-weight: 500;
      margin-top: 1rem;
      position: relative; 
    }
  }

  @media screen and (max-width: 920px) {
    section.hero {
      justify-content: space-between;
      height: 40vh;
      h1 {
        font-size: 2.25rem;
        font-weight: 400;
        padding: 0 0 2rem 2rem;
      }
    }
  }
</style>

<script is:inline>
  const video = document.getElementById("hero-vid");
  if (video) {
    const tryPlay = () => {
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      const p = video.play();
      if (p && typeof p.catch === "function") p.catch(() => {});
    };

    tryPlay();
    ["loadedmetadata", "canplay", "canplaythrough"].forEach((evt) =>
      video.addEventListener(evt, tryPlay, { once: true })
    );
    window.addEventListener("pageshow", tryPlay);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) tryPlay();
    });
  }
</script>