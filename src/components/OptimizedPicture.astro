---
import { getImageFilenameAlt } from "../utils/getImageFilenameAlt";

interface Props {
  src: string;
  alt?: string;
  class?: string;
  loading?: "lazy" | "eager";
  style?: string;
}

const { src, class: className = "", loading = "lazy", style: styles = "" } = Astro.props;

const fullFilename = src.split('/').pop() || src;
const filenameParts = fullFilename.split('.');
const filename = filenameParts.length > 1 ? filenameParts.slice(0, -1).join('.') : fullFilename;
const fileExtension = filenameParts.length > 1 ? filenameParts[filenameParts.length - 1] : 'webp';

const desktopSrc = `/uploads/optimized/${filename}-desktop.webp`;
const tabletSrc = `/uploads/optimized/${filename}-tablet.webp`;
const mobileSrc = `/uploads/optimized/${filename}-mobile.webp`;
const fallbackSrc = `/uploads/${filename}.${fileExtension}`;
const dynamicAlt = getImageFilenameAlt(src);
---

<picture class={className}>
  <source media="(min-width: 920px)" srcset={desktopSrc} type="image/webp" />
  <source media="(min-width: 600px) and (max-width: 919px)" srcset={tabletSrc} type="image/webp" />
  <source media="(max-width: 599px)" srcset={mobileSrc} type="image/webp" />
  
  <img
    src={fallbackSrc}
    alt={dynamicAlt}
    loading={loading}
    style={styles}
  />
</picture>

<style>
  picture {
    display: block;
  }
  
  picture img {
    display: block;
    width: 100%;
    border-radius: 8px;
  }

  picture.desktop {
    display: block;
  }
  picture.mobile {
    display: none;
  }

  @media screen and (max-width: 920px) {
    picture.desktop {
      display: none;
    }
    picture.mobile {
      display: block;
    }
  }
</style>