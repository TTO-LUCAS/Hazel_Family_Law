---
import { Image } from "astro:assets";
import ImgPlaceholder from "../assets/more-shadows.webp";
---

<section class="contact-section">
  <div class="contact-content">
    <h2 style="font-weight: 400;">Contact</h2>
    <p class="lead-in">
      We welcome the opportunity to discuss your situation confidentially—by
      phone, in person or via the form below.
    </p>
    <form name="contact" method="POST" netlify>
      <input
        type="hidden"
        name="subject"
        value="Contact Form Inquiry from Hazel Website"
      />
      <div class="contact-form" id="name-field">
        <label for="name">Full Name</label>
        <input
          type="text"
          name="name-full"
          id="name"
          required
          placeholder="Full Name"
          autocomplete="on"
        />
      </div>
      <div class="contact-form" id="email-field">
        <label for="email">Email Address</label>
        <input
          type="text"
          name="email"
          id="email"
          required
          placeholder="Email Address"
          autocomplete="on"
        />
      </div>
      <div class="contact-form" id="phone-field">
        <label for="phone">Phone Number</label>
        <input
          type="text"
          name="phone"
          id="phone"
          placeholder="Phone Number"
          autocomplete="on"
        />
      </div>
      <div class="contact-form" id="preference-field">
        <label for="time">Contact Preference (Time)</label>
        <input
          type="text"
          name="time"
          id="time"
          placeholder="Contact Preference (Time)"
          autocomplete="on"
        />
      </div>
      <div class="contact-form" id="message-field">
        <label for="message">Message</label>
        <textarea
          name="message"
          id="message"
          required
          rows="4"
          placeholder="Message"></textarea>
      </div>
      <div class="contact-form" id="submit-field">
        <input type="submit" value="Submit" />
      </div>
    </form>
  </div>
  <div class="picture-placeholder">
    <Image
      src={ImgPlaceholder}
      alt="A photo of shadows against a warm background."
      loading="lazy"
      width="1920"
      height="1080"
    />
  </div>
</section>

<style lang="scss">
  .contact-section {
    min-height: 100vh;
    height: auto;
    width: 100%;
    background: var(--oat-husk);
    color: var(--burnt-umber);
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    .contact-content {
      padding: 5rem 12rem 5rem 2rem;
      width: 60%;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      h2 {
        padding: 0;
        margin: 0 0 5rem 0;
      }
      p.lead-in {
        font-size: 1.5rem;
        font-weight: 300;
        margin: 0 0 5rem 0;
      }
      p {
        font-size: 1.125rem;
        font-weight: 300;
      }
      form {
        margin: 0 0 0 0;
        display: grid;
        grid-template-rows: repeat(8, 1fr);
        grid-template-columns: repeat(8, 1fr);
        gap: 0.5rem;
        height: 60%;
        border: 2px none var(--burnt-umber);
        font-weight: 300;
        *:focus {
          outline: none;
          // box-shadow: 0 0 0 1px var(--burnt-umber);
        }
        *:focus-visible {
          // outline: 1px solid var(--burnt-umber);
        }
        .contact-form {
          position: relative;
          border: 1px none var(--burnt-umber);
          border-radius: 8px;
          margin: 0rem 0rem 0rem 0rem;
          font-weight: 300;
          &:has(input[required], textarea[required])::after {
            content: "*";
            position: absolute;
            top: 0.5rem;
            right: 0.75rem;
            color: var(--hazelwood);
            font-size: 1.25rem;
            line-height: 1rem;
            z-index: 1;
            pointer-events: none;
          }
          label {
            position: absolute;
            top: 0.5rem;
            left: 0.75rem;
            display: none;
          }
          input {
            background: transparent;
            border: 1px solid var(--burnt-umber);
            border-radius: 8px;
            width: 100%;
            height: 100%;
            padding: 0rem 1rem 0rem 1rem;
            &::placeholder {
              color: var(--burnt-umber);
              opacity: 1;
              font-weight: 300;
            }
          }
          textarea {
            padding: 1rem;
            width: 100%;
            height: 100%;
            border: 1px solid var(--burnt-umber);
            border-radius: 8px;
            background: transparent;
            resize: none;
            font-weight: 300;
            &::placeholder {
              color: var(--burnt-umber);
              opacity: 1;
              font-weight: 300;
            }
          }
        }
        #name-field {
          grid-column: 1 / span 4;
          grid-row: 1 / span 1;
        }
        #email-field {
          grid-column: 5 / -1;
          grid-row: 1 / span 1;
        }
        #phone-field {
          grid-column: 1 / span 4;
          grid-row: 2 / span 1;
        }
        #preference-field {
          grid-column: 5 / -1;
          grid-row: 2 / span 1;
        }
        #message-field {
          grid-column: 1 / -1;
          grid-row: 3 / span 5;
        }
        #submit-field {
          grid-column: 1 / span 2;
          grid-row: 8 / span 1;
          padding: 2.5rem 0 0 0;
          input[type="submit"] {
            grid-column: 1 / span 1;
            height: 2rem;
            background: var(--hazelwood);
            padding: 0 1.25rem;
            color: var(--morning-fog);
            border-radius: 2.125rem;
            font-size: 18px;
            border: none;
            cursor: pointer;
            text-align: center;
            line-height: 2rem;
            transition:
              background 0.2s ease-in-out,
              border 0.2s ease-in-out,
              color 0.2s ease-in-out;
          }
          input[type="submit"]:hover {
            background: var(--burnt-umber);
          }
          input[type="submit"]:active {
            text-decoration: underline;
          }
        }
      }
    }
    .picture-placeholder {
      border: none;
      margin: 0;
      padding: 0;
      width: 40%;
      height: auto;
      overflow: hidden;
      img {
        margin: 0;
        padding: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }

  @media screen and (max-width: 920px) {
    .contact-section {
      margin: 0;
      height: auto;
      width: 100%;
      background: var(--oat-husk);
      color: var(--burnt-umber);
      display: flex;
      flex-direction: column-reverse;
      justify-content: flex-end;
      .contact-content {
        padding: 2.5rem 2rem 2.5rem 2rem;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        h2 {
          margin: 0 0 2.5rem 0;
          font-size: 1.45rem;
          font-weight: 400;
        }
        p.lead-in {
          font-size: 1rem;
          font-weight: 300;
          margin: 0 0 2.5rem 0;
        }
        p {
          font-size: 1.15rem;
          font-weight: 300;
        }
        form {
          margin: 0 0 0 0;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
          height: auto;
          border: 2px none var(--burnt-umber);
          font-weight: 300;
          *:focus {
            outline: none;
          }
          .contact-form {
            position: relative;
            border: 1px none var(--burnt-umber);
            border-radius: 8px;
            margin: 0rem 0rem 0rem 0rem;
            height: 2rem;
            &:has(input[required], textarea[required])::after {
              content: "*";
              position: absolute;
              top: 0.5rem;
              right: 0.75rem;
              color: var(--hazelwood);
              font-size: 1.25rem;
              line-height: 1rem;
              z-index: 1;
              pointer-events: none;
            }
            &:has(textarea) {
              height: auto;
              min-height: 8rem;
            }
            label {
              position: absolute;
              top: 0.5rem;
              left: 0.75rem;
              display: none;
            }
            input {
              font-size: 16px;
              background: transparent;
              border: 1px solid var(--burnt-umber);
              border-radius: 8px;
              width: 100%;
              height: 100%;
              padding: 0rem 1rem 0rem 1rem;
              touch-action: manipulation;
              &::placeholder {
                color: var(--burnt-umber);
                opacity: 1;
                font-size: 1rem;
                font-weight: 300;
              }
            }
            textarea {
              font-size: 16px;
              padding: 1rem;
              width: 100%;
              height: 100%;
              border: 1px solid var(--burnt-umber);
              border-radius: 8px;
              background: transparent;
              resize: none;
              touch-action: manipulation;
              &::placeholder {
                color: var(--burnt-umber);
                opacity: 1;
                font-size: 1rem;
                font-weight: 300;
              }
            }
          }
          #message,
          #message-field {
            min-height: 18rem;
            flex-grow: 1;
          }
          #submit-field {
            padding: 0rem 0 0 0;
            input[type="submit"] {
              height: 2rem;
              background: var(--hazelwood);
              padding: 0 1.25rem;
              color: var(--oat-husk);
              border-radius: 34px;
              font-size: 1.125rem;
              border: none;
              cursor: pointer;
              text-align: center;
              line-height: 2rem;
              transition:
                background 0.8s ease-in-out,
                border 0.8s ease-in-out,
                color 0.8s ease-in-out;
            }
            input[type="submit"]:hover {
              background: var(--burnt-umber);
            }
            input[type="submit"]:active {
              text-decoration: underline;
            }
          }
        }
      }
      .picture-placeholder {
        width: 100%;
        height: 100%;
        img {
          object-fit: cover;
          width: 100%;
          height: 100%;
        }
      }
    }
  }
</style>

<script lang="js" is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const currentPg = window.location.pathname;
    const picContainer = document.querySelector(".picture-placeholder");

    if (!picContainer) return;

    // Image configurations per page
    const imageMap = {
      "/services": {
        base: "20260402p_hazelfamilylaw_dariacataldo_002_web-2",
        alt: "A photo of Daria Cataldo of Hazel Family Law & Mediation. A pair of palm frongs can be seen, out of focus in the foreground. The setting is a warmly lit interior with inviting and calming décor.",
      },
      "/resources": {
        base: "20260402p_hazelfamilylaw_elisaturco_001_web-2",
        alt: "A photo of Elisa Turco of Hazel Family Law & Mediation. A pair of palm frongs can be seen, out of focus in the foreground. The setting is a warmly lit interior with inviting and calming décor.",
      },
    };

    const config = imageMap[currentPg];
    if (!config) return;

    // Create picture element with responsive sources
    const picture = document.createElement("picture");

    // Helper to create source elements
    const createSource = (media, srcset) => {
      const source = document.createElement("source");
      source.media = media;
      source.srcset = srcset;
      source.type = "image/webp";
      return source;
    };

    // Add responsive sources for different viewports
    picture.appendChild(
      createSource(
        "(min-width: 921px)",
        `/uploads/optimized/${config.base}-desktop.webp`,
      ),
    );
    picture.appendChild(
      createSource(
        "(min-width: 481px) and (max-width: 920px)",
        `/uploads/optimized/${config.base}-tablet.webp`,
      ),
    );
    picture.appendChild(
      createSource(
        "(max-width: 480px)",
        `/uploads/optimized/${config.base}-mobile.webp`,
      ),
    );

    // Create fallback img element
    const img = document.createElement("img");
    img.src = `/uploads/optimized/${config.base}-desktop.webp`;
    img.alt = config.alt;
    img.loading = "lazy";
    img.style.cssText =
      "margin: 0; padding: 0; display: block; width: 100%; height: 100%; object-fit: cover;";
    picture.appendChild(img);

    // Remove all existing children from container
    while (picContainer.firstChild) {
      picContainer.removeChild(picContainer.firstChild);
    }

    // Add new picture element
    picContainer.appendChild(picture);
  });
</script>
