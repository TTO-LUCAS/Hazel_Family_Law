---
interface Props {
  src: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  width?: number;
  height?: number;
  class?: string;
}

const { 
  src, 
  alt, 
  loading = 'lazy',
  width,
  height,
  class: className
} = Astro.props;

// Check if image is from public uploads (starts with /uploads/)
const isPublicUpload = src.startsWith('/uploads/');
const optimizedSrc = isPublicUpload 
  ? src.replace('/uploads/', '/uploads/.optimized/').replace(/\.[^.]+$/, '.webp')
  : src;
---

<img 
  src={optimizedSrc} 
  alt={alt}
  loading={loading}
  width={width}
  height={height}
  class={className}
/>

<style>
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>